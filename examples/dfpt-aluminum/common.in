# Reference fcc aluminum, a = 7.65 bohr. Relax and converge settings separately.
lattice face-centered Cubic 7.65
coords-type lattice
ion-species ../../build/pseudopotentials/SG15/Al_ONCV_PBE.upf
ion Al 0 0 0 1
coulomb-interaction periodic
spintype no-spin
elec-ex-corr gga-PBE
elec-cutoff 30
kpoint-folding 8 8 8

# Partially occupied and empty bands must be identical in SCF and DFPT.
elec-smearing Fermi 0.01
elec-n-bands 12
electronic-minimize nIterations 500 energyDiffThreshold 1e-13
electronic-scf nIterations 200 nEigSteps 30 \
    energyDiffThreshold 0 eigDiffThreshold 0 residualThreshold 1e-10 \
    mixFraction 0.4
