#!/usr/bin/env python3
"""Convert screened Cartesian DFPT derivatives to mode-resolved Bloch couplings.

Output is one NPZ per computed q, with g[k, mode, final_band, initial_band].
This utility evaluates the computed coarse q mesh; it does not interpolate
electronic Bloch gauges or electron-phonon couplings to new k/q points.
"""
import argparse
import importlib.machinery
import importlib.util
from pathlib import Path
import numpy as np

HARTREE_MEV = 27211.386245988
AMU = 1822.88839


def phonon_module():
    loader = importlib.machinery.SourceFileLoader(
        'phononDFPT', str(Path(__file__).resolve().with_name('phononDFPT')))
    spec = importlib.util.spec_from_loader(loader.name, loader)
    module = importlib.util.module_from_spec(spec)
    loader.exec_module(module)
    return module


def lines(path):
    return [line for line in Path(path).read_text().splitlines()
            if line.strip() and not line.lstrip().startswith('#')]


def manifest(prefix):
    data = lines(prefix + 'phononEph')
    version, nq, nk, nb, nm = map(int, data[0].split())
    if version != 1 or min(nq, nk, nb, nm) <= 0:
        raise ValueError('unsupported or invalid phononEph header')
    qs = np.array([list(map(float, line.split())) for line in data[1:]])
    if qs.shape != (nq, 3) or not np.isfinite(qs).all():
        raise ValueError('invalid phononEph q mesh')
    return qs, (nk, nb, nm)


def load_q(prefix, index, expected=None):
    filename = prefix + f'phononEphQ{index:06d}'
    data = lines(filename + '.meta')
    version, nk, nb, nm = map(int, data[0].split())
    if version != 1 or min(nk, nb, nm) <= 0:
        raise ValueError('unsupported or invalid electron-phonon metadata')
    if expected is not None and (nk, nb, nm) != expected:
        raise ValueError('electron-phonon dimensions differ from manifest')
    if len(data) != 2 + 3*nk:
        raise ValueError('incomplete electron-phonon metadata')
    q = np.array(list(map(float, data[1].split())))
    ks = np.array([list(map(float, data[2+3*k].split())) for k in range(nk)])
    source = np.array([list(map(float, data[3+3*k].split())) for k in range(nk)])
    target = np.array([list(map(float, data[4+3*k].split())) for k in range(nk)])
    if q.shape != (3,) or ks.shape != (nk, 8) or source.shape != (nk, nb) or target.shape != (nk, nb):
        raise ValueError('invalid electronic metadata shapes')
    if not all(np.isfinite(array).all() for array in (q, ks, source, target)):
        raise ValueError('nonfinite electronic metadata')
    if not np.allclose(ks[:, 5:], ks[:, :3] + q, atol=1e-12, rtol=0):
        raise ValueError('target k coordinates do not equal k+q')
    if not np.all(ks[:, 4] == np.rint(ks[:, 4])) or np.any(ks[:, 4] < -1) or np.any(ks[:, 4] >= nk):
        raise ValueError('invalid target k indices')
    if Path(filename).stat().st_size != 16*nm*nk*nb*nb:
        raise ValueError('electron-phonon binary size does not match metadata')
    # Each C++ matrix is column-major: final band varies fastest on disk.
    raw = np.memmap(filename, dtype='<c16', mode='r', shape=(nm, nk, nb, nb))
    derivative = raw.transpose(0, 1, 3, 2)
    return q, ks, source, target, derivative


def mode_couplings(derivative, dynamical, masses, minimum_mev=0.01):
    """g_mnv = sum_a e_av dH_mn/du_a / sqrt(2 M_a omega_v), atomic units.

    Eigenvectors are normalized in mass-weighted Cartesian coordinates.
    Zero/imaginary modes have no real zero-point normalization and are NaN.
    """
    eigenvalues, eigenvectors = np.linalg.eigh(dynamical)
    omega = np.sign(eigenvalues)*np.sqrt(np.abs(eigenvalues))
    valid = omega > minimum_mev/HARTREE_MEV
    polarization = eigenvectors/np.sqrt(masses[:, None]*AMU)
    g = np.einsum('av,akmn->kvmn', polarization, derivative, optimize=True)
    g[:, valid] /= np.sqrt(2*omega[valid])[None, :, None, None]
    g[:, ~valid] = complex(np.nan, np.nan)
    return g, omega, eigenvalues, eigenvectors, valid


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('prefix', help='DFPT dump prefix, e.g. phonon.')
    parser.add_argument('-o', '--output-dir', type=Path, default=Path('electron-phonon'))
    parser.add_argument('--q-index', type=int, action='append', help='zero-based q index; repeat to select several')
    parser.add_argument('--bands', type=int, nargs=2, metavar=('FIRST', 'STOP'),
                        help='zero-based band slice, STOP excluded, for both matrix axes')
    parser.add_argument('--units', choices=('meV', 'eV', 'Hartree'), default='meV')
    parser.add_argument('--min-frequency-meV', dest='min_frequency_mev', type=float, default=0.01,
                        help='exclude frequencies below this positive threshold (default 0.01 meV)')
    args = parser.parse_args()
    try:
        if not np.isfinite(args.min_frequency_mev) or args.min_frequency_mev <= 0:
            raise ValueError('--min-frequency-meV must be positive and finite')
        qs, dimensions = manifest(args.prefix)
        nk, nb, nm = dimensions
        indices = list(dict.fromkeys(args.q_index)) if args.q_index is not None else range(len(qs))
        if any(index < 0 or index >= len(qs) for index in indices):
            raise ValueError('--q-index is outside the computed q mesh')
        first, stop = args.bands if args.bands else (0, nb)
        if not 0 <= first < stop <= nb:
            raise ValueError('--bands must satisfy 0 <= FIRST < STOP <= number of bands')
        phonon = phonon_module()
        cells, force = phonon.load(args.prefix)
        basis = phonon.read_text_array(args.prefix + 'phononBasis', dtype=str)
        if len(basis) != nm:
            raise ValueError('phonon basis and electron-phonon mode counts differ')
        masses = basis[:, -1].astype(float)
        if not np.isfinite(masses).all() or np.any(masses <= 0):
            raise ValueError('invalid atomic masses')
        conversion = {'meV': HARTREE_MEV, 'eV': HARTREE_MEV/1000, 'Hartree': 1.}[args.units]
        args.output_dir.mkdir(parents=True, exist_ok=True)
        for index in indices:
            q, ks, source, target, derivative = load_q(args.prefix, index, dimensions)
            if not np.allclose(q, qs[index], atol=1e-12, rtol=0):
                raise ValueError('q metadata differs from manifest')
            derivative = derivative[:, :, first:stop, first:stop]
            if not np.isfinite(derivative).all():
                raise ValueError('nonfinite Hamiltonian derivatives')
            dyn = phonon.interpolate(cells, force, q)[0]
            g, omega, eigs, vectors, valid = mode_couplings(
                derivative, dyn, masses, args.min_frequency_mev)
            outfile = args.output_dir/f'q{index:06d}.npz'
            np.savez_compressed(outfile, q=q, kpoints=ks[:, :3], kplusq=ks[:, 5:],
                                kweights=ks[:, 3], target_k_indices=ks[:, 4].astype(int),
                                band_indices=np.arange(first, stop), energy_unit=args.units,
                                band_energies=source[:, first:stop]*conversion,
                                target_band_energies=target[:, first:stop]*conversion,
                                g=g*conversion, phonon_energies=omega*conversion,
                                omega_squared=eigs, eigenvectors=vectors, valid_modes=valid,
                                cartesian_derivatives_Hartree_per_bohr=derivative)
            print(f'{outfile}: g[{nk}, {nm}, {stop-first}, {stop-first}] in {args.units}; '
                  f'{valid.sum()}/{nm} modes have real zero-point normalization')
    except (OSError, ValueError, IndexError) as error:
        parser.exit(1, f'electronPhononDFPT: {error}\n')


if __name__ == '__main__':
    main()
